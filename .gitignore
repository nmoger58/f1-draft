# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/

# Node artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore heavy raw training datasets and archives
/datasets/*
!/datasets/
!/datasets/races.csv
!/datasets/results.csv
!/datasets/drivers.csv
!/datasets/constructors.csv
!/datasets/driver_standings.csv
!/datasets/constructor_standings.csv
!/datasets/circuits.csv
!/datasets/sprint_results.csv
!/datasets/f1_team_radio_commentary.csv

# Allow full tracking of the F1 autonomous simulator suite
!/datasets/f1-simulator/
!/datasets/f1-simulator/**
datasets/f1-simulator/node_modules/
datasets/f1-simulator/scratch/
datasets/f1-simulator/*.log
